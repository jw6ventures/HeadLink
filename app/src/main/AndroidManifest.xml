<?xml version="1.0" encoding="utf-8"?>
<!-- USB accessory acquisition, connectedDevice foreground service, and session
     notification (spec §5.2 baseline). TLS, authentication, and discovery add no
     permission. From P9, INTERNET too, for live traffic alone; see its entry below.

     P5.1 adds no <uses-permission>. Head-unit transport buttons reach whatever is
     playing through AudioManager.dispatchMediaKeyEvent, which declares none. Reporting
     what is playing needs MediaAccessService below to be enabled by the operator in
     system Settings: that is a binding the operator makes, not a permission this app can
     request, and the integration works without it (spec §5.2, APP09). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.usb.accessory"
        android:required="true" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- P5.5, the owned map and its dashboard header. Each is separately optional and
         the feature degrades to "—" without it (APP09); none is requested unless the
         operator turns that integration on. Map data stays operator-supplied (APP10):
         the INTERNET declared below is for live traffic, never for maps or routing.

         ACCESS_NETWORK_STATE is a normal permission and reports the transport type only
         — wifi, cell or none. ACCESS_FINE_LOCATION is the position *fallback*: the
         vehicle's own LOCATION is preferred wherever it exists and needs no Android
         permission at all, so on a head unit that populates it this grant is never the
         source the map follows. READ_PHONE_STATE is solely the signal-bar count from
         SignalStrength.getLevel.

         COARSE is declared beside FINE because Android lets the operator grant only the
         coarse one, and an app that asks for FINE alone gets nothing in that case. The
         fallback follows whichever was granted: GPS when FINE, the network provider
         when only COARSE. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <!-- P9: live traffic from HERE (docs/p9-plan.md §2, APP10 as amended 28 September
         2026). The one opt-in integration that uses the network. It is off by default,
         and with it off the app makes no network connection: TrafficClient opens no
         socket unless the operator has turned Traffic on and saved their own HERE key
         (host-tested, TrafficClientTest). With it on, it contacts only HERE's traffic
         API host, only while a route is being followed, and keeps nothing it receives
         beyond the next response. The handshake, projection, maps and routing never use
         it. INTERNET is an install-time permission the operator cannot revoke on stock
         Android (GrapheneOS's Network toggle can), which is why the guarantee is in the
         code. Cleartext is allowed only in debug builds, for the lab's stand-in server
         (src/debug/res/xml/network_security_config.xml). -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- P7.9: optional full call controls (docs/p7-plan.md §5.8; §9 item 3 as amended in
         docs/p7-backends-results.md §4.2). signature|appop: declaring it grants nothing,
         and the permission itself is never granted to this app (it is not platform-signed;
         pm refuses to grant it). What Telecom honours is the app-op: it binds
         CallCompanionService below once the operator has allowed that op from a computer,
         with CallControl.GRANT_COMMAND, which is
         adb shell appops set [two hyphens]user 0 org.openautoandroid.source MANAGE_ONGOING_CALLS allow
         (spelled out, because an XML comment cannot hold two hyphens in a row; the user
         flag names the phone's owner on a multi-user phone; docs/p7-8-9-results.md §3.1), and even then only while a session projects with
         Call controls on. Without the
         grant, Call controls fall back to the dialer's call notification (answer, decline,
         hang up; no mute, no keypad). CALL_COMPANION_APP is not declared: Telecom has not
         bound on it since Android 11. -->
    <uses-permission android:name="android.permission.MANAGE_ONGOING_CALLS" />

    <!-- P10: weather from Breezy Weather (docs/p10-plan.md, spec.md 5.2 as amended). A
         third-party dangerous permission, Breezy's own: asked for only when the operator
         turns Settings, Weather, Show weather on, and the weather item degrades to a dash
         without it (APP09). It lets Breezy's content provider answer; it is not a network
         permission, and weather never uses the network (APP10 is untouched). Before each
         read WeatherFeed checks the provider belongs to org.breezyweather, since any app
         could declare this permission name if Breezy were not installed. -->
    <uses-permission android:name="org.breezyweather.READ_PROVIDER" />

    <!-- W0: the wireless probe (docs/wireless-investigation.md, spec.md 5.2 as amended
         14 October 2026). A runtime grant (Nearby devices), asked for only when the
         operator opens Diagnostics, Wireless probe; nothing else in the app touches
         Bluetooth. With it the probe lists paired devices and asks the one picked which
         services it offers (one SDP query). After an advertised verdict, and only on a
         second tap, W1 opens one RFCOMM connection to that service, reads the head unit's
         wireless setup and closes; it joins no network. Neither report carries a device
         name or address, and W1's keeps no Wi-Fi key (spec.md 5.2, the W1 amendment). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- W2: wireless projection (docs/wireless-investigation.md, spec.md 5.2, the W2
         amendment). A normal, install-time permission for one thing: the local-only
         network request for the head unit's own Wi-Fi, which Android confirms with the
         operator once. Nothing else in the app requests a network. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />

    <!-- W3: start wireless projection when the truck connects over Bluetooth
         (docs/wireless-w3-procedure.md, spec.md 5.2, the W3 amendment). Both are normal,
         install-time permissions and do nothing on their own: they apply only once the
         operator has linked the app to the truck through Android's companion-device dialog
         (Settings, Link the truck for wireless), and stop applying when that
         link is removed. The first lets Android wake WirelessCompanionService when the
         linked truck connects; the second lets the app, so woken, start its foreground
         services with no screen showing. -->
    <uses-permission android:name="android.permission.REQUEST_OBSERVE_COMPANION_DEVICE_PRESENCE" />
    <uses-permission android:name="android.permission.REQUEST_COMPANION_START_FOREGROUND_SERVICES_FROM_BACKGROUND" />
    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <!-- Wireless standby (docs/wireless-w3-procedure.md, spec.md 5.2, the standby
         amendment). A normal, install-time permission. The app holds a partial wake lock
         only while the linked truck's own start request (its Android Auto button) is being
         set up, at most 90 s and released once the session starts, and for 5 s to answer
         each Bluetooth frame from the truck while waiting for one, so a phone asleep in a
         pocket still answers the button. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- P7.5: the idle media pane lists player apps that can be resumed with no session
         left, through Android's media resumption (docs/p7-plan.md §5.5). This makes apps
         exporting a MediaBrowserService visible to this one. It is a package-visibility
         declaration, not a permission, and names no app (§9 item 3).

         P8.1: the same for text-to-speech engines (docs/p8-plan.md §3). Without it,
         TextToSpeech finds no engine on targetSdk 30 and later and fails silently. The
         app uses whichever engine the system default is, and reports its package and
         whether it holds INTERNET; it adds no permission of its own. -->
    <queries>
        <intent>
            <action android:name="android.media.browse.MediaBrowserService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <!-- P10: Breezy Weather's provider, so its authority resolves on targetSdk 30 and
             later. Names Breezy's authority only; no other app becomes visible. -->
        <provider android:authorities="org.breezyweather.provider.weather" />
    </queries>

    <application
        android:name=".SourceApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenAutoAndroid">
        <activity
            android:name=".ConnectionActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity>
        <!-- P6.4: destinations shared from another app, OsmAnd above all, which does the
             offline address search this app does not (P6 plan §5.1). Plain text through
             the share sheet, and geo: URIs from anything that opens a location. Adds no
             permission; the route starts from the vehicle's position or, only if the
             operator has already granted it, the phone's. No window, and no task of its
             own: it routes, says so in a toast, and leaves the driver where they were. -->
        <activity
            android:name=".DestinationActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/destination_label"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="geo" />
            </intent-filter>
        </activity>
        <!-- The route preview: a phone map of the route with alternatives to pick from.
             Its own process, because VTM keeps its settings in statics that the head
             unit's map sets for a 240 dpi panel; see PreviewActivity. -->
        <activity
            android:name=".PreviewActivity"
            android:exported="false"
            android:label="@string/preview_title"
            android:process=":preview" />
        <!-- W0's probe screen, opened from Diagnostics only: no launcher entry, not exported. -->
        <activity
            android:name=".WirelessProbeActivity"
            android:exported="false"
            android:label="@string/wireless_probe_label" />
        <!-- W2/W3: the foreground while a wireless link sets up, until ProjectionService
             takes over; see WirelessLinkService. -->
        <service
            android:name=".WirelessLinkService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <!-- W3: bound by Android's companion-device service alone, which BIND_COMPANION_DEVICE_SERVICE
             guarantees, when the linked truck connects; exported for that reason only. -->
        <service
            android:name=".WirelessCompanionService"
            android:exported="true"
            android:permission="android.permission.BIND_COMPANION_DEVICE_SERVICE">
            <intent-filter>
                <action android:name="android.companion.CompanionDeviceService" />
            </intent-filter>
        </service>
        <service
            android:name=".ProjectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
        <!-- Enabled by the operator in Settings, never bound by this app.
             MediaSessionManager.getActiveSessions accepts only a notification listener or
             the signature-level MEDIA_CONTENT_CONTROL, so this is the one route an
             ordinary app has to read what another application is playing.

             It reads notifications only when the operator turns a feature on that needs
             them (P7.8, docs/p7-plan.md §9 item 6): with "Notifications on the dashboard"
             on and not paused, it reads alerting notifications and keeps them in memory
             for the session, never stored or reported; with Call controls on and the
             in-call service below not bound, it reads call notifications for their
             caller and Answer, Decline and Hang up. With both off it reads none. See
             MediaAccessService. -->
        <service
            android:name=".MediaAccessService"
            android:exported="false"
            android:label="@string/media_access_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- P10: Breezy Weather's update notifier (docs/p10-plan.md §3). Breezy lists the
             apps that declare this under Settings, Modules, and sends the broadcast to the
             ones the operator ticks. Exported and guarded by no permission, because Breezy
             sends it with none; it carries no weather, only a cue to read the provider
             again, so a forged one can cause no more than a harmless extra read, and only
             while a projection is attached with Show weather on. Lint's ExportedReceiver
             is waived here for that reason: a permission would stop Breezy reaching it. -->
        <receiver
            android:name=".WeatherNotifierReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="org.breezyweather.ACTION_UPDATE_NOTIFIER" />
            </intent-filter>
        </receiver>
        <!-- P7.9: optional call controls (docs/p7-plan.md §5.8). Disabled here, and
             enabled by CallControl only while a session projects with the operator's
             Call controls setting on; disabled again at the end of the session and on
             every app start. BIND_INCALL_SERVICE means only Telecom can bind it, and it
             is exported, as the InCallService documentation requires, for that reason
             alone. It declares no IN_CALL_SERVICE_UI and no car-mode UI metadata: it
             draws nothing, and the phone's own dialer stays the call screen. -->
        <service
            android:name=".CallCompanionService"
            android:enabled="false"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>
    </application>

</manifest>
