<?xml version="1.0" encoding="utf-8"?>
<!-- P7.7: the phone screen's colours, light. values-night holds the dark set; the theme
     (themes.xml) is DeviceDefault.DayNight, so the system's own dark setting picks one.
     The accent is the dashboard's blue, darkened here so white text on it keeps contrast. -->
<resources>
    <color name="accent">#FF1F6FD1</color>
    <color name="on_accent">#FFFFFFFF</color>
    <color name="card">#FFF0F2F5</color>
    <color name="tab_bar">#FFE6E9EE</color>
    <color name="tab_text">#FF4A525C</color>
    <color name="status_quiet">#FFF0F2F5</color>
    <color name="status_busy">#FFDCE9FA</color>
    <color name="status_good">#FFDDF2E1</color>
    <color name="status_problem">#FFFBE0DD</color>
</resources>
