<?xml version="1.0" encoding="utf-8"?>
<!-- The artwork is the whole icon, so it is the full-bleed background layer (generated by
     tools/make-icon.py from art/headlink-icon-source.png); the monochrome glyph is for
     Android's themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/launcher_art" />
    <foreground android:drawable="@android:color/transparent" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
