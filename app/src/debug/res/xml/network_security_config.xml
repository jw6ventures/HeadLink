<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Cleartext to the lab host alone, as the emulator reaches it:
     10.0.2.2 (the emulator's alias for the host) and the loopback address an
     `adb reverse` port arrives on. Everything else keeps the defaults: HTTPS only, the
     system's certificate authorities only. TrafficClient honours its base URL override
     in a debuggable build only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
