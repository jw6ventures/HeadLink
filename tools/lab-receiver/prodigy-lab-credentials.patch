Lab-only change to the pinned OpenAuto Prodigy protocol library (GPL-3.0), applied by
tools/lab-receiver.sh to a checkout outside this repository. The receiver's TLS client
identity comes from generated PEM files named by OAA_LAB_CERT_PEM and OAA_LAB_KEY_PEM;
the library's embedded third-party certificate and key are never used by this build.

diff --git a/libs/prodigy-oaa-protocol/src/Messenger/Messenger.cpp b/libs/prodigy-oaa-protocol/src/Messenger/Messenger.cpp
index 6d4d21e..b86c700 100644
--- a/libs/prodigy-oaa-protocol/src/Messenger/Messenger.cpp
+++ b/libs/prodigy-oaa-protocol/src/Messenger/Messenger.cpp
@@ -1,6 +1,7 @@
 #include <oaa/Messenger/Messenger.hpp>
 #include <oaa/Channel/ChannelId.hpp>
 #include <QtEndian>
+#include <QFile>
 #include <QDebug>
 
 #include <limits>
@@ -215,7 +216,14 @@ void Messenger::sendRaw(uint8_t channelId, const QByteArray& data,
 void Messenger::startHandshake()
 {
     handshakeFailureEmitted_ = false;
-    if (!cryptor_.init(Cryptor::Role::Client)) {
+    // Lab build: generated credentials only; never the embedded third-party key.
+    QFile certificate(QString::fromLocal8Bit(qgetenv("OAA_LAB_CERT_PEM")));
+    QFile privateKey(QString::fromLocal8Bit(qgetenv("OAA_LAB_KEY_PEM")));
+    if (!certificate.open(QIODevice::ReadOnly) || !privateKey.open(QIODevice::ReadOnly)) {
+        failHandshake(QStringLiteral("lab build requires OAA_LAB_CERT_PEM and OAA_LAB_KEY_PEM"));
+        return;
+    }
+    if (!cryptor_.init(Cryptor::Role::Client, certificate.readAll(), privateKey.readAll())) {
         failHandshake(cryptor_.lastError());
         return;
     }
